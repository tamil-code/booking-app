{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["bun-types", "node"]
  },
  "include": ["src/**/*.ts", "src/*.ts", "tests/**/*.ts", "tests/*.ts"],
  "exclude": ["node_modules", "dist"]
}
